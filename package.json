{
  "name": "zhiyuanyundong-wms",
  "version": "4.8.2",
  "description": "智源云动-wms后台管理系统",
  "author": "ZCC",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:prod": "vite build",
    "build:electron": "vite build --mode electron",
    "electron:prepare": "node electron/prepare-runtime.cjs",
    "electron:dev": "npm run electron:prepare && npm run build:electron && electron .",
    "electron:build": "npm run electron:prepare && npm run build:electron && node electron/build.cjs",
    "electron:dir": "npm run electron:prepare && npm run build:electron && node electron/build.cjs --dir",
    "preview": "vite preview"
  },

  "dependencies": {
    "@element-plus/icons-vue": "2.0.10",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "9.5.0",
    "axios": "0.27.2",
    "echarts": "5.4.0",
    "element-plus": "2.2.27",
    "file-saver": "2.0.5",
    "fuse.js": "6.6.2",
    "js-cookie": "3.0.1",
    "jsbarcode": "^3.11.6",
    "jsencrypt": "3.3.1",
    "moment": "^2.30.1",
    "nprogress": "0.2.0",
    "pinia": "2.0.22",
    "qrcode": "^1.5.3",
    "vue": "3.2.45",
    "vue-cropper": "1.0.3",
    "vue-plugin-hiprint": "^0.0.56",
    "vue-router": "4.1.4",
    "vue3-seamless-scroll": "^2.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "3.1.0",
    "@vue/compiler-sfc": "3.2.45",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "sass": "1.56.1",
    "unplugin-auto-import": "0.11.4",
    "unplugin-vue-setup-extend-plus": "0.4.9",
    "vite": "3.2.3",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons": "2.0.1"
  },
  "build": {
    "appId": "com.zhiyuanyundong.wms",
    "productName": "智源云动WMS",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
